// sluice config. Comments are allowed (JSONC).
//
// Servers usually live one per file in servers.d/ next to this file:
//   sluice presets             list ready-made servers
//   sluice add github          add one with a safe default whitelist
// You can also define servers here under "servers" by hand.
//
// Secrets never go in config files: reference them as ${env:NAME} and put the
// values in the .env file next to this file (or in the real environment).
// OAuth servers (Vercel, Linear, Notion, ...) store tokens under tokens/ after
// `sluice login <server>`.
//
// Whitelist rules (per server):
//   allow           glob patterns of tools that may be listed and called. Empty = nothing.
//   deny            glob patterns that are always blocked, even if allowed above.
//   allow_readonly  also allow tools the server itself marks readOnlyHint=true.
// Run `sluice policy <server>` to see every tool and the decision for it.
{
  "servers": {},

  // Every call (allowed or denied) is appended to audit.jsonl; see `sluice audit`.
  // Argument values are not logged unless log_args is true.
  "audit": { "enabled": true, "log_args": false },

  // Cap on bytes `sluice call` prints, to protect the agent's context. 0 = no cap.
  "max_output": 100000
}
